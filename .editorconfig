# ---------------------------------------------------------------------------
# Paradise Resort — Sistema de Gestión Hotelera
# Estándares de código (ver CLAUDE.md, sección 15)
# ---------------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,scss,html}]
indent_size = 2
quote_type = single

[*.{cs,csx}]
indent_size = 4

# --- Organización de usings ------------------------------------------------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# --- Estilo del lenguaje ---------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# --- Preferencias de calidad -----------------------------------------------
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion

# --- Convenciones de nombres ------------------------------------------------
# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i_pascal_case
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal_case.required_prefix = I
dotnet_naming_style.prefix_i_pascal_case.capitalization = pascal_case

# Tipos y miembros públicos: PascalCase
dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_rule.types_are_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_symbols.types_and_members.applicable_accessibilities = public, protected, internal
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Campos privados: _camelCase
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Parámetros y variables locales: camelCase
dotnet_naming_rule.parameters_are_camel_case.severity = warning
dotnet_naming_rule.parameters_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_are_camel_case.style = camel_case
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel_case.capitalization = camel_case

# --- Analizadores ----------------------------------------------------------
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CS1591.severity = none
