{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/src/API/HotelParadiseResort.API.csproj",
        "--launch-profile",
        "http"
      ],
      "port": 5170,
      "url": "http://localhost:5170"
    },
    {
      "name": "web-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
